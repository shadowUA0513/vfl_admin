# Both the Vite dev server and Netlify proxy /api to the backend, so the app
# needs no configuration to reach it. Nothing here has to be set.

# Point the app somewhere other than the proxied /api path.
# VITE_API_URL=http://46.62.230.64:8081/api/v1

# Run against the local localStorage mock instead of the real API.
# VITE_USE_MOCK=true

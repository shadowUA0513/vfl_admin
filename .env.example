# Base URL of the VFL API.
#
# Leave this unset (or delete the line) to run against the built-in mock in
# src/api/mockAuth.ts, where ANY email and password signs you in as
# superadmin. Use editor@vfl.com or viewer@vfl.com to land on those roles
# instead and exercise the route guards.
#
# Setting this switches login to the real endpoint and the bypass stops
# running entirely.
VITE_API_URL=https://api.vfl.example.com
